# Rendered at container start by the nginx image's envsubst step: ONLY
# ${STATIC_URL_SECRET} is substituted (NGINX_ENVSUBST_FILTER), so every real
# nginx $variable is left intact. The secret is injected from the environment
# so it never lives in this (public) repo.
events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Compress text (bundle JS/CSS, API JSON) — including proxied responses.
    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/manifest+json;

    upstream backend {
        server api:8000;
    }


    server {
        listen 80;
        server_name localhost;

        # Profile pics are member-only too: signed like art (the API signs
        # Profile.profile_pic_path).
        location /static/profile/ {
            secure_link $arg_md5,$arg_expires;
            secure_link_md5 "$secure_link_expires$uri ${STATIC_URL_SECRET}";
            if ($secure_link = "")  { return 403; }
            if ($secure_link = "0") { return 410; }
            alias /app/static/profile/;
            add_header Cache-Control "private, max-age=21600";
        }

        # 256px profile-pic thumbs, signed (Profile.profile_pic_thumb_path).
        location /static/profile-thumbs/ {
            secure_link $arg_md5,$arg_expires;
            secure_link_md5 "$secure_link_expires$uri ${STATIC_URL_SECRET}";
            if ($secure_link = "")  { return 403; }
            if ($secure_link = "0") { return 410; }
            alias /app/static/profile-thumbs/;
            # URL carries ?v=<mtime> + signature, so its bytes never change.
            add_header Cache-Control "private, max-age=21600, immutable";
        }

        # --- Member-only art bytes -------------------------------------------
        # The API hands signed URLs (secure_link) only to authenticated members;
        # nginx refuses any request without a valid, unexpired signature. "" =>
        # bad/absent signature (403); "0" => expired (410). Fail-closed.
        location /static/art/ {
            secure_link $arg_md5,$arg_expires;
            secure_link_md5 "$secure_link_expires$uri ${STATIC_URL_SECRET}";
            if ($secure_link = "")  { return 403; }
            if ($secure_link = "0") { return 410; }
            alias /app/static/art/;
            add_header Cache-Control "private, max-age=21600";
        }
        location /static/written-form/ {
            secure_link $arg_md5,$arg_expires;
            secure_link_md5 "$secure_link_expires$uri ${STATIC_URL_SECRET}";
            if ($secure_link = "")  { return 403; }
            if ($secure_link = "0") { return 410; }
            alias /app/static/written-form/;
            add_header Cache-Control "private, max-age=21600";
        }
        location /static/audio/ {
            secure_link $arg_md5,$arg_expires;
            secure_link_md5 "$secure_link_expires$uri ${STATIC_URL_SECRET}";
            if ($secure_link = "")  { return 403; }
            if ($secure_link = "0") { return 410; }
            alias /app/static/audio/;
            add_header Cache-Control "private, max-age=21600";
        }

        # Resized art derivatives (512px thumb, ~1600px display copy), signed
        # like the originals — the API embeds thumb_url/display_url so browsers
        # and the app load them directly. The gated /art/{id}/thumb|display
        # routes remain for older app builds.
        location /static/thumbs/ {
            secure_link $arg_md5,$arg_expires;
            secure_link_md5 "$secure_link_expires$uri ${STATIC_URL_SECRET}";
            if ($secure_link = "")  { return 403; }
            if ($secure_link = "0") { return 410; }
            alias /app/static/thumbs/;
            # URL carries ?v=<mtime> + signature, so its bytes never change.
            add_header Cache-Control "private, max-age=21600, immutable";
        }

        location /static/display/ {
            secure_link $arg_md5,$arg_expires;
            secure_link_md5 "$secure_link_expires$uri ${STATIC_URL_SECRET}";
            if ($secure_link = "")  { return 403; }
            if ($secure_link = "0") { return 410; }
            alias /app/static/display/;
            # URL carries ?v=<mtime> + signature, so its bytes never change.
            add_header Cache-Control "private, max-age=21600, immutable";
        }

        # Inspiration-web external art is member-gated: the api's
        # GET /external-art/{id}/image route is the only way in, so the raw
        # files must not be reachable here (mirrors the profile-thumbs lockdown).
        location /static/external/ {
            return 404;
        }
        location /static/external-thumbs/ {
            return 404;
        }

        # Public portfolio derivatives are served ONLY via the api's
        # visibility-gated /p/img/ route; block raw file access so flipping a
        # piece private is instant revocation.
        location /static/public/ {
            return 403;
        }

        # Other static (event images, etc.) stays public for now.
        location /static/ {
            alias /app/static/;
            expires 1d;
            add_header Cache-Control "public, immutable";
        }

        # Public portfolio pages + images (no auth — the api gates on
        # portfolio.published / art.visibility). Kept off /api/ so public URLs
        # carry no hint of the app behind them.
        location /p/ {
            proxy_pass http://backend/p/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /robots.txt {
            default_type text/plain;
            # nginx does NOT unescape \n in return strings — the literal
            # multi-line quoted string below is the correct way to emit newlines.
            return 200 "User-agent: *
Disallow: /api/
Disallow: /static/
Allow: /p/
";
        }

        # API requests
        location /api/ {
            client_max_body_size 20M;
            proxy_pass http://backend/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Frontend: the built bundle (src/ui/nginx.conf sets its cache headers).
        # Resolved per request via Docker DNS, so `docker compose up -d --build
        # frontend` (new container, new IP) needs no nginx restart.
        location / {
            resolver 127.0.0.11 valid=10s;
            set $frontend_upstream http://frontend:80;
            proxy_pass $frontend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
